{
  "expo": {
    "name": "Qontri",
    "slug": "mobile",
    "version": "1.0.5",
    "runtimeVersion": "1.0.0",
    "owner": "adarsh196",
    "updates": {
      "url": "https://u.expo.dev/3ef85cd4-0471-4761-888a-f329de9e8e4f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qontri.app"
    },
    "android": {
      "package": "com.qontri.app",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-symbol.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-symbol.png",
          "resizeMode": "cover",
          "backgroundColor": "#0A1628"
        }
      ],
      "@sentry/react-native/expo",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "3ef85cd4-0471-4761-888a-f329de9e8e4f"
      }
    }
  }
}
