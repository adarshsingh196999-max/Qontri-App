{
  "expo": {
    "name": "Qontri",
    "slug": "mobile",
    "version": "1.0.2",
    "runtimeVersion": "1.0.0",
    "privacy": "public",
    "owner": "adarsh196",
    "updates": {
      "url": "https://u.expo.dev/3ef85cd4-0471-4761-888a-f329de9e8e4f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/images/icon-symbol.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.qontri.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-symbol.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3ef85cd4-0471-4761-888a-f329de9e8e4f"
      }
    }
  }
}